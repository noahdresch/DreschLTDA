<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <!--
      Unidade de persistência do CRUD de Empresas (Tomcat / RESOURCE_LOCAL).
      DataSource HikariCP injetado via CDI (db.properties) — sem JNDI de app server.
      Namespace JPA: https://jakarta.ee/xml/ns/persistence (obrigatório para o parser do Hibernate).
    -->
    <persistence-unit name="empresasPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.onboardingrsd.empresas.model.Empresa</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
